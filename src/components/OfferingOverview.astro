---
interface Props {
  heading?: string;
  offerings: { name: string; summary: string; href?: string; image?: string }[];
}

const { heading = "产品与服务", offerings } = Astro.props;
const count = offerings.length;
const gridCols =
  count <= 3 ? "sm:grid-cols-3" : count === 4 ? "sm:grid-cols-2 lg:grid-cols-4" : "sm:grid-cols-2 lg:grid-cols-3";
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="section-eyebrow justify-center">Offerings</p>
      <h2 class="section-title mt-4">
        {heading}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        工装、外贸小单、针织衫和面料都从同一套自有产线能力里展开
      </p>
    </div>

    <div class={`mt-14 grid gap-6 grid-cols-1 ${gridCols}`}>
      {offerings.map((o, i) => {
        const isLinked = Boolean(o.href);
        const Tag = isLinked ? "a" : "article";
        return (
          <Tag
            href={o.href}
            data-reveal
            style={`--reveal-delay:${(i % 4) * 90}ms`}
            class:list={[
              "group relative isolate block overflow-hidden rounded-xl bg-slate-950 text-white",
              isLinked && "transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-950/20",
              isLinked && "focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2",
              "min-h-[280px] sm:min-h-[320px]",
            ]}
          >
            {o.image && (
              <img
                src={o.image}
                alt=""
                width="1200"
                height="675"
                loading="lazy"
                class:list={[
                  "absolute inset-0 h-full w-full object-cover opacity-86",
                  isLinked && "transition duration-500 ease-out group-hover:scale-105 group-focus-visible:scale-105",
                ]}
              />
            )}
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(8,13,23,0.10)_0%,rgba(8,13,23,0.52)_48%,rgba(8,13,23,0.88)_100%)]"></div>
            <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(8,13,23,0.55)_0%,rgba(8,13,23,0.24)_55%,rgba(8,13,23,0.08)_100%)]"></div>
            <div class="absolute inset-0 flex flex-col justify-end p-6">
              <h3 class="max-w-xl text-balance text-xl font-bold tracking-tight sm:text-2xl">
                {o.name}
              </h3>
              <p class="mt-3 max-w-xl text-pretty text-sm leading-6 text-white/78">{o.summary}</p>
              {isLinked && (
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-white">
                  了解详情
                  <span class="transition duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1" aria-hidden="true">→</span>
                </span>
              )}
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</section>
