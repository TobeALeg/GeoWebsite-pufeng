---
/**
 * 原料溯源 — 全球优选羊毛故事。深色背景 + 非对称图集。
 */
interface Step {
  title: string;
  desc: string;
}
interface GalleryImg {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  steps?: Step[];
  gallery: GalleryImg[];
}
const {
  eyebrow = "原料溯源",
  heading,
  lead,
  steps = [],
  gallery = [],
} = Astro.props;
const [g0, g1, g2, g3, g4] = gallery;
---

<section class="bg-slate-950 text-white">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        {eyebrow && <p class="section-eyebrow text-primary/90" style="color:#7cb0ff">{eyebrow}</p>}
        <h2 class="mt-4 font-heading text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
          {heading}
        </h2>
        {lead && <p class="mt-4 max-w-xl text-pretty leading-7 text-white/70 sm:text-lg">{lead}</p>}

        {
          steps.length > 0 && (
            <ol class="mt-9 space-y-6 border-l border-white/15 pl-6">
              {steps.map((s, i) => (
                <li class="relative">
                  <span class="absolute -left-[1.65rem] top-1 flex h-3 w-3 items-center justify-center rounded-full bg-emerald-400 ring-4 ring-emerald-400/15" aria-hidden="true" />
                  <h3 class="text-base font-bold text-white">
                    <span class="mr-2 text-white/40">{String(i + 1).padStart(2, "0")}</span>
                    {s.title}
                  </h3>
                  <p class="mt-1.5 text-sm leading-6 text-white/65">{s.desc}</p>
                </li>
              ))}
            </ol>
          )
        }
      </div>

      {/* 非对称图集 */}
      <div class="grid grid-cols-2 gap-3 sm:gap-4" data-reveal style="--reveal-delay:120ms">
        {g0 && (
          <figure class="col-span-2 overflow-hidden rounded-2xl ring-1 ring-white/10">
            <img src={g0.src} alt={g0.alt} width="900" height="500" loading="lazy" class="aspect-[16/9] h-full w-full object-cover" />
          </figure>
        )}
        {g1 && (
          <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
            <img src={g1.src} alt={g1.alt} width="500" height="500" loading="lazy" class="aspect-square h-full w-full object-cover" />
          </figure>
        )}
        {g2 && (
          <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
            <img src={g2.src} alt={g2.alt} width="500" height="500" loading="lazy" class="aspect-square h-full w-full object-cover" />
          </figure>
        )}
        {g3 && (
          <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
            <img src={g3.src} alt={g3.alt} width="500" height="500" loading="lazy" class="aspect-square h-full w-full object-cover" />
          </figure>
        )}
        {g4 && (
          <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
            <img src={g4.src} alt={g4.alt} width="500" height="500" loading="lazy" class="aspect-square h-full w-full object-cover" />
          </figure>
        )}
      </div>
    </div>
  </div>
</section>
