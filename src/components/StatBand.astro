---
interface Stat {
  value: string;
  unit?: string;
  label: string;
  note?: string;
}
interface Props {
  visual?: "default" | "wanwang";
  stats: Stat[];
}
const { visual = "default", stats } = Astro.props;
---

{
  visual === "wanwang" ? (
    <section id="stat" class="scroll-mt-16 bg-primary text-white">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
        <div class="grid grid-cols-2 gap-6 sm:gap-10 lg:grid-cols-4">
          {stats.map((s, i) => (
            <div class="text-center" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/18 text-white sm:h-20 sm:w-20">
                <span class="text-xl font-black sm:text-2xl">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <p class="mt-4 text-3xl font-black tracking-tight sm:mt-6 sm:text-4xl md:text-5xl">
                {s.value}
                {s.unit && <span class="ml-1 text-sm font-semibold text-white/75 sm:text-base">{s.unit}</span>}
              </p>
              <p class="mt-2 text-xs font-bold text-white sm:mt-3 sm:text-sm">{s.label}</p>
              {s.note && <p class="mx-auto mt-1.5 max-w-40 text-xs leading-5 text-white/76 sm:mt-2 sm:max-w-48 sm:text-sm sm:leading-6">{s.note}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section id="stat" class="scroll-mt-16 bg-slate-100">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20">
        <div class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
          {stats.map((s, i) => (
            <div class="h-full rounded-xl border border-slate-200/60 bg-white p-4 shadow-sm shadow-slate-900/[0.04] sm:rounded-2xl sm:p-6" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <p class="text-3xl font-bold tracking-tight text-primary sm:text-4xl md:text-5xl">
                {s.value}
                {s.unit && <span class="ml-1 text-xs font-semibold text-slate-400 sm:text-base">{s.unit}</span>}
              </p>
              <p class="mt-2 text-xs font-semibold leading-5 text-default sm:mt-3 sm:text-sm">{s.label}</p>
              {s.note && <p class="mt-1.5 text-xs leading-5 text-muted sm:mt-2 sm:text-sm sm:leading-6">{s.note}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
