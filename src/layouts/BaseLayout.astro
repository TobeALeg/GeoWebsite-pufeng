---
import "../styles.css";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { loadSiteContent, type SiteContent } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  includeHeader?: boolean;
  includeFooter?: boolean;
  site?: SiteContent;
}

const {
  title = "",
  description = "",
  canonical,
  jsonld = [],
  noindex = false,
  includeHeader = true,
  includeFooter = true,
  site = loadSiteContent(),
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const theme = site.global.theme;
const themeCss = theme
  ? `:root:root{${[
      theme.primary ? `--aw-color-primary:${theme.primary}` : "",
      theme.secondary ? `--aw-color-secondary:${theme.secondary}` : "",
      theme.accent ? `--aw-color-accent:${theme.accent}` : "",
      theme.page ? `--aw-color-bg-page:${theme.page}` : "",
      theme.surface ? `--aw-color-bg-surface:${theme.surface}` : "",
    ]
      .filter(Boolean)
      .join(";")}}`
  : "";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {themeCss && <style is:inline set:html={themeCss} />}

    {
      jsonld.map((obj) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />
      ))
    }
  </head>
  <body class="bg-page text-default antialiased tracking-tight">
    {includeHeader && <SiteHeader currentPath={Astro.url.pathname} site={site} />}
    <div>
      <slot />
    </div>
    {includeFooter && <SiteFooter site={site} />}
    <script is:inline>
      const header = document.querySelector("[data-aw-sticky-header]");
      if (header && !header.hasAttribute("data-solid-header")) {
        const syncHeader = () => header.classList.toggle("scroll", window.scrollY > 8);
        syncHeader();
        window.addEventListener("scroll", syncHeader, { passive: true });
      }

      // 滚动揭示:元素进入视口即加 .is-visible(只触发一次)。
      const revealEls = document.querySelectorAll("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
